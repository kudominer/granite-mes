# ===== StoneFlow Pro - Environment Variables (TEMPLATE) =====
# Copy file này thành ".env" và điền giá trị thật.
# KHÔNG commit file .env (đã nằm trong .gitignore).

# --- Supabase (dùng chung hoặc riêng cho đá hoa cương) ---
# Lấy từ: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Kết nối DB (chỉ dùng cho script scripts/db-exec.js để tạo bảng/cột) ---
# Lấy từ: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# VD: postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xxxx.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@pooler.supabase.com:5432/postgres

# --- App config ---
# Tên xưởng hiển thị trên header
WORKSHOP_NAME=Xưởng Chú Cẩn & Kudo
# Chủ xưởng (quyền toàn quyền)
OWNER_NAME=Chú Cẩn
# Thợ / hỗ trợ
WORKER_NAME=Kudo

# --- Netlify (tùy chọn, có thể để trên dashboard thay vì file) ---
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
